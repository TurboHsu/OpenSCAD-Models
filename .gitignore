*.stl
*.3mf
*.obj

# Machine-local config & preferences (see .env.example and LOCAL.md.example)
.env
LOCAL.md

# OpenSCAD & editor backups
*.scad~
*.bak
*.tmp

# Python & OS junk
__pycache__/
*.py[cod]
.venv/
.DS_Store
Thumbs.db
